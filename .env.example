# Configuración de Supabase para Letreros Olivar SpA
# 1. Crea un proyecto gratuito en https://supabase.com
# 2. Ejecuta el archivo supabase/schema.sql en el SQL Editor de Supabase
# 3. Copia este archivo a .env y completa tus credenciales (o agrégalas en Cloudflare Pages > Settings > Environment variables)

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY
